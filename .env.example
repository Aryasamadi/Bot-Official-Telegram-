# ════════════════════════════════════════════════════════════════
# نمونه‌ی پیکربندی — این فایل را به .env کپی کنید و مقادیر را بگذارید:
#   cp .env.example .env
# همه‌ی مقدارهای عددی زیر «پیش‌فرض» هستند؛ هر خط را می‌توانید حذف کنید
# (مقدار پیش‌فرض همان‌جا در newsbot/config.py اعمال می‌شود).
# عدد نامعتبر باعث crash نمی‌شود — پیش‌فرض + هشدار در preflight.
# ════════════════════════════════════════════════════════════════

# ── هویت ربات (الزامی) ──
BOT_TOKEN=123456789:AA...
SUPER_ADMIN_IDS=123456789

# ── دیتابیس ──
# sqlite = پیش‌فرض (فایل محلی) · d1 = Cloudflare D1 به‌عنوان Source of Truth
DB_BACKEND=sqlite
DB_FILE=newsbot.db
# برای DB_BACKEND=d1 هر سه مقدار زیر لازم است:
#CF_ACCOUNT_ID=
#CF_D1_DATABASE_ID=
#CF_D1_TOKEN=
#D1_TIMEOUT=30

# ── آینه‌ی اختیاری «بیشتر» روی Cloudflare KV (هر سه لازم) ──
#CF_ACCOUNT_ID=
#CF_KV_NAMESPACE_ID=
#CF_API_TOKEN=

# ── سرور محلی Bot API (اختیاری؛ آپلود تا ۲۰۰۰MB به‌جای ۵۰MB) ──
#TELEGRAM_API_BASE=
#MAX_MEDIA_MB=50
#MAX_PAGE_MB=8

# ── زمان و نگهداری داده ──
DEFAULT_UTC_OFFSET=3.5
#DEFAULT_TZ=Asia/Tehran
DATA_TTL_HOURS=72
DEDUP_TTL_HOURS=72
DEEPLINK_TTL_DAYS=30
#ARCHIVE_DAYS=365

# ── سقف‌ها و تایم‌اوت‌های شبکه ──
MAX_MEDIA_MB=50
MAX_PAGE_MB=8
MAX_ARTICLE_CHARS=120000
MAX_ARTICLE_PAGES=5
MAX_QUEUE_SIZE=500
MAX_DAILY_POSTS_CAP=500
#BOT_FULL_HARD_MAX=60000
#RETRY_AFTER_MAX=120
#FETCH_TOTAL_SEC=60
#MEDIA_TOTAL_SEC=600
#FEED_RETRY_AFTER_MAX=15

# ── هوش مصنوعی ──
AI_CONCURRENCY=3
AI_INPUT_TEXT_CHARS=8000
AI_MAX_CALLS_PER_ARTICLE=12
AI_ARTICLE_TIME_BUDGET=240
AI_MAX_MODEL_ATTEMPTS=6
AI_CACHE_TTL_DAYS=14
#AI_MERGE_MAX_DEPTH=3
#AI_CONTENT_RETRY_MODELS=1
#AI_DAILY_FREE=20
#AI_DAILY_PAID=200
#MODEL_BACKOFF_MAX_MIN=120
#MODEL_PROBE_BATCH=3
# سقفِ زمانیِ یک درخواستِ پروایدر (مستقل از بودجهٔ fetchِ منابع)
#AI_PROVIDER_TIMEOUT_SEC=180
# تلاشِ دوباره برای خطاهای گذرا (۴۲۹/۵xx/timeout) — خطای دائمی تکرار نمی‌شود
#AI_TRANSIENT_RETRIES=2
#AI_RETRY_BASE_SEC=2
#AI_RETRY_MAX_DELAY_SEC=20
# خاموشیِ کوتاهِ مدل بعد از خطای موقت (پیش‌تر ۲۰ دقیقه ⇒ توقفِ کلِ تولید)
#MODEL_TRANSIENT_BACKOFF_MIN=2
#MODEL_TRANSIENT_BACKOFF_MAX_MIN=15

# ── هم‌زمانی و زمان‌بندی ──
FETCH_CONCURRENCY=8
CYCLE_CONCURRENCY=2
MAX_CYCLES_PER_TICK=4
DB_POOL_SIZE=8
MAINT_POOL_SIZE=1
PUBLISH_CONCURRENCY=2
MAX_PUBLISHES_PER_TICK=8
TELEGRAM_POOL_SIZE=32
TICK_SECONDS=120
RECOVER_EVERY_MIN=5
TEST_COOLDOWN_SEC=120
#SOURCE_PAUSE_MIN=30
#MIN_INTERVAL=30
#STALE_UPDATE_MAX_MIN=60
#CB_RATE=0.6
#ABUSE_RATE_SEC=1.0
#GLOBAL_RATE_MAX=40
#GLOBAL_RATE_WINDOW=10
#PAY_STUCK_MIN=10
#AWAIT_TTL_SEC=1800
# PH-06: اگر اتوماسیون/کانال فعال باشد و آخرین انتشار موفق از این تعداد ساعت قدیمی‌تر
# باشد، هشدار dead-man برای مدیر کلان فرستاده می‌شود (بازهٔ مجاز: ۱ تا ۷۲۰ ساعت).
#DEADMAN_STALE_HOURS=24

# ── ارجاع — REF-3/تصمیم ۸ (فاز ۱۲) ──
# پاداش با «هر خرید» فرد دعوت‌شده به معرف می‌رسد؛ درصد و سقف مبلغی از پنل
# سوپرادمین (دکمه‌ی «🤝 ارجاع») هم قابل تغییر است. مقدار زیر فقط پیش‌فرض است.
# PH-01: سقفِ مبلغی **به تفکیکِ واحدِ پول** اعمال می‌شود (پاداشِ تومانی با سقفِ دلاری
# جمع نمی‌شود) و کیف پول هم به تفکیکِ واحد نگه‌داری می‌شود.
REFERRAL_ENABLED=1
REFERRAL_PERCENT=20
# PH-01: آستانهٔ اختلافِ مؤثر بین مبلغِ نمایش‌داده‌شده به مشتری و مبلغِ بازمحاسبه‌شده
# با کیف پولِ زنده (درصد — واحد-مستقل). ۰ یعنی هر اختلافی تأیید را متوقف می‌کند.
PAY_QUOTE_TOLERANCE_PCT=0

# ── امنیت ──
# کلید رمزنگاری کلیدهای AI در حالت سکون (Fernet مشتق‌شده با SHA-256).
# هر رشته‌ی دلخواه و طولانی بگذارید؛ خالی = بدون رمزنگاری (برای نصب‌های موجود سازگار است،
# ولی برای نصب جدید قویاً توصیه می‌شود).
#SECRETS_KEY=
# فقط برای پرووایدرهای AI محلی مثل Ollama/LM Studio:
# PH-02/Q-5 — این دیگر یک پرچمِ boolean نیست؛ فهرستِ «میزبان:پورت»هایی است که اجازهٔ
# دسترسی به میزبانِ خصوصی دارند (جداشده با کاما). خالی (پیش‌فرض) = هیچ میزبانِ خصوصی
# مجاز نیست. «all» = همهٔ میزبان‌های خصوصی (پذیرشِ آگاهانهٔ ریسک — توصیه نمی‌شود).
#ALLOW_PRIVATE_MODEL_HOSTS=127.0.0.1:11434

# ── کانال اجباری (فقط برای ادمین‌ها؛ اختیاری) ──
#MANDATORY_CHANNEL_ID=-1001234567890
#MANDATORY_CHANNEL_USERNAME=mychannel
