# ---- تلگرام ----
BOT_TOKEN=
SUPER_ADMIN_IDS=123456789
# ---- داده‌ها (مسیر پایدار؛ حتماً داخل ReadWritePaths سرویس) ----
DB_FILE=/opt/newsbot/data/newsbot.db
# ---- Cloudflare D1 = منبع حقیقتِ دائمی ----
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# توکن با مجوز Account → D1 → Edit (اگر خالی باشد CF_API_TOKEN استفاده می‌شود)
CF_D1_API_TOKEN=
D1_REQUIRED=1            # 0 فقط برای آزمایش: بدون D1 ربات اجرا می‌شود ولی داده با تعویض VPS از بین می‌رود
D1_STRICT=1              # 1: پیش از ارسال به تلگرام باید D1 فاز in_flight را تأیید کند (مهم برای جلوگیری از انتشار تکراری)
# DEFAULT_TZ=Asia/Tehran   (نام IANA؛ خالی ⇒ از DEFAULT_UTC_OFFSET حدس زده می‌شود)
# PROVIDER_CONCURRENCY=2   MAX_CONCURRENT_UPDATES=256
# MEDIA_MAX_TRIES=3   ALLOW_PRIVATE_MODEL_HOSTS=0   (۱ فقط برای مدل‌های خصوصی مثل Ollama محلی)
# D1_BARRIER_TIMEOUT=10   RETRY_MAX_ATTEMPTS=6   RETRY_BASE_SEC=300
# D1_SYNC_INTERVAL=3  D1_LEASE_TTL=90  D1_LEASE_WAIT=150  D1_FORCE_RESTORE=0  D1_FORCE_SEED=0
# ---- اختیاری (بقیهٔ متغیرهای موجود ربات دست‌نخورده‌اند) ----
# CF_KV_NAMESPACE_ID=  CF_API_TOKEN=  TELEGRAM_API_BASE=  AI_CONCURRENCY=3  FETCH_CONCURRENCY=8
