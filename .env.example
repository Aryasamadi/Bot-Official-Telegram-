# ── هویت ربات (الزامی) ──
BOT_TOKEN=123456789:AA...
SUPER_ADMIN_IDS=123456789

# ── دیتابیس ──
# sqlite = پیش‌فرض (فایل محلی) · d1 = Cloudflare D1 به‌عنوان Source of Truth
DB_BACKEND=sqlite
DB_FILE=newsbot.db
# برای DB_BACKEND=d1 هر سه مقدار زیر لازم است:
#CF_ACCOUNT_ID=
#CF_D1_DATABASE_ID=
#CF_D1_TOKEN=
#D1_TIMEOUT=30

# ── آینه‌ی اختیاری «بیشتر» روی Cloudflare KV (هر سه لازم) ──
#CF_KV_NAMESPACE_ID=

# ── سرور محلی Bot API (اختیاری؛ آپلود تا ۲۰۰MB) ──
#TELEGRAM_API_BASE=

# ── زمان و نگهداری داده ──
DEFAULT_UTC_OFFSET=3.5
DATA_TTL_HOURS=72
DEDUP_TTL_HOURS=72
DEEPLINK_TTL_DAYS=30

# ── سقف‌ها ──
MAX_MEDIA_MB=50
MAX_PAGE_MB=8
MAX_ARTICLE_CHARS=120000
MAX_ARTICLE_PAGES=5
MAX_QUEUE_SIZE=500
MAX_DAILY_POSTS_CAP=500

# ── هوش مصنوعی ──
AI_CONCURRENCY=3
AI_INPUT_TEXT_CHARS=8000
AI_MAX_CALLS_PER_ARTICLE=12
AI_ARTICLE_TIME_BUDGET=240
AI_MAX_MODEL_ATTEMPTS=3
AI_CACHE_TTL_DAYS=14

# ── هم‌زمانی و زمان‌بندی ──
FETCH_CONCURRENCY=8
CYCLE_CONCURRENCY=2
MAX_CYCLES_PER_TICK=4
TICK_SECONDS=120
RECOVER_EVERY_MIN=5
TEST_COOLDOWN_SEC=120

# ── ارجاع (Referral) ──
REFERRAL_ENABLED=1
REFERRAL_PERCENT=10
REFERRAL_MAX_PER_USER=50

# ── کانال اجباری (فقط برای ادمین‌ها؛ اختیاری) ──
#MANDATORY_CHANNEL_ID=-1001234567890
#MANDATORY_CHANNEL_USERNAME=mychannel

# ── امنیت (فقط برای پرووایدرهای AI محلی مثل Ollama) ──
#ALLOW_PRIVATE_MODEL_HOSTS=1
