[Unit]
Description=NewsBot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newsbot
WorkingDirectory=/opt/newsbot/app
EnvironmentFile=/etc/newsbot/env
ExecStartPre=/opt/newsbot/venv/bin/python bot.py --check
ExecStart=/opt/newsbot/venv/bin/python bot.py
Restart=always
RestartSec=5
# خاموشی تمیز: لغو تسک‌ها (≤۸s) + flush نهایی D1 (≤۱۰s) + آزادسازی lease
KillSignal=SIGTERM
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/newsbot/data
UMask=0077

[Install]
WantedBy=multi-user.target
